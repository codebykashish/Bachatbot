rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow users to read/write their own profile document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow users to read/write all subcollections under their user document
      // (This covers /users/{userId}/messages, /users/{userId}/transactions, etc.)
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Explicitly fallback to deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
